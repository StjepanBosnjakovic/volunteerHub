<% roster = confirmed_roster(shift) %>
<% tone, label, pct = shift_fill_status(shift) %>
<div class="<%= card_classes(hover: true) %>">
  <div class="grid grid-cols-[72px_minmax(0,1fr)] items-center gap-5 px-5 py-4.5 lg:grid-cols-[88px_minmax(0,1fr)_180px_auto]">
    <div class="border-r border-gray-100 pr-4 text-center">
      <div class="text-[11px] font-semibold uppercase tracking-widest text-indigo-700"><%= shift.starts_at.strftime("%b") %></div>
      <div class="text-3xl font-bold leading-none text-gray-900"><%= shift.starts_at.day %></div>
      <div class="mt-0.5 text-[11px] text-gray-500"><%= shift.starts_at.strftime("%a") %></div>
    </div>

    <div class="min-w-0">
      <div class="mb-1.5 flex flex-wrap items-center gap-2.5">
        <h3 class="text-[17px] font-semibold text-gray-900">
          <%= link_to shift.title, program_shift_path(program, shift), class: "hover:text-indigo-600", data: { turbo_frame: "_top" } %>
        </h3>
        <%= pill label, tone: tone %>
        <% if shift.recurrence_rule.present? %>
          <%= pill "Recurring", tone: :info, dot: false %>
        <% end %>
        <% if shift.waitlist_enabled && shift.full? %>
          <%= pill "Waitlist open", tone: :warn, dot: false %>
        <% end %>
      </div>
      <div class="flex flex-wrap items-center gap-1.5 text-[13px] text-gray-500">
        <%= icon "clock", size: 13 %>
        <span class="whitespace-nowrap"><%= shift_time_range(shift) %></span>
        <% if shift.location.present? %>
          <span class="text-gray-300">·</span>
          <%= icon "map-pin", size: 13 %>
          <span><%= shift.location %></span>
        <% end %>
        <% if shift.coordinator %>
          <span class="text-gray-300">·</span>
          <%= icon "user", size: 13 %>
          <span>Lead: <%= shift.coordinator.display_name %></span>
        <% end %>
      </div>
    </div>

    <div class="col-span-2 lg:col-span-1">
      <div class="mb-1.5 flex justify-between text-xs text-gray-500">
        <span>Volunteers</span>
        <span class="font-mono"><%= roster.size %><%= "/#{shift.capacity}" if shift.capacity %></span>
      </div>
      <%= progress_bar pct, tone: tone == :neutral ? :brand : tone %>
      <% if roster.any? %>
        <div class="mt-2"><%= avatar_stack roster, size: :xs, max: 5 %></div>
      <% end %>
    </div>

    <div class="col-span-2 flex gap-2 lg:col-span-1">
      <% if policy(Shift).assign? %>
        <%= button_link "Assign", program_shift_path(program, shift), variant: :secondary, size: :sm, icon: "user-plus", data: { turbo_frame: "_top" } %>
      <% else %>
        <%= button_link "View", program_shift_path(program, shift), variant: :secondary, size: :sm, icon_right: "arrow-right", data: { turbo_frame: "_top" } %>
      <% end %>
    </div>
  </div>
</div>
