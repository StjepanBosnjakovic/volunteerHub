<% field_class = "w-full rounded-lg border border-gray-300 bg-white px-3 text-sm text-gray-900 focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/15" %>
<%= form_with model: broadcast, class: "#{card_classes} p-5" do |f| %>
  <div class="mb-4 flex items-center gap-2.5">
    <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-orange-500 text-white">
      <%= icon "megaphone", size: 16 %>
    </span>
    <h2 class="text-lg font-semibold text-gray-900"><%= broadcast.persisted? ? "Edit broadcast" : "New broadcast" %></h2>
  </div>

  <% if broadcast.errors.any? %>
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 p-4">
      <ul class="list-inside list-disc text-sm text-red-700">
        <% broadcast.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= eyebrow "Channel", css: "mb-2" %>
  <div class="mb-4.5 grid grid-cols-2 gap-2">
    <% [["in_app", "In-app notification", "bell"], ["email", "Email", "mail"],
        ["sms", "SMS", "message-circle"], ["whatsapp", "WhatsApp", "send"]].each do |value, label, icon_name| %>
      <label class="flex cursor-pointer items-center gap-2.5 rounded-xl border border-gray-300 bg-white px-3 py-2.5 text-gray-900 has-checked:border-indigo-600 has-checked:bg-indigo-50/60 has-checked:ring-3 has-checked:ring-indigo-600/15">
        <%= f.radio_button :channel, value, class: "peer sr-only" %>
        <%= icon icon_name, size: 16, css: "text-gray-400 peer-checked:text-indigo-600" %>
        <span class="flex-1">
          <span class="block text-[13px] font-semibold"><%= label %></span>
          <% if value.in?(%w[sms whatsapp]) %>
            <span class="block text-[11px] text-gray-500">Feature flagged</span>
          <% end %>
        </span>
        <%= icon "circle-check", size: 16, css: "hidden text-indigo-600 peer-checked:block" %>
      </label>
    <% end %>
  </div>

  <div class="mb-4.5 rounded-xl border border-gray-200 bg-gray-50 p-4"
       data-controller="segment-builder"
       data-segment-builder-preview-url-value="<%= preview_segment_broadcast_messages_path %>">
    <%= eyebrow "Audience", css: "mb-3" %>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
      <div>
        <%= f.label "segment_filters[role]", "Role", class: "mb-1 block text-xs font-medium text-gray-600" %>
        <%= f.select "segment_filters[role]",
            [["All roles", ""], ["Volunteer", "volunteer"], ["Coordinator", "coordinator"]],
            { selected: broadcast.segment_filters["role"] },
            class: "#{field_class} h-9",
            data: { action: "change->segment-builder#preview" } %>
      </div>
      <div>
        <%= f.label "segment_filters[program_id]", "Program", class: "mb-1 block text-xs font-medium text-gray-600" %>
        <%= f.select "segment_filters[program_id]",
            programs.map { |p| [p.name, p.id] },
            { include_blank: "All programs", selected: broadcast.segment_filters["program_id"] },
            class: "#{field_class} h-9",
            data: { action: "change->segment-builder#preview" } %>
      </div>
      <div>
        <%= f.label "segment_filters[volunteer_status]", "Volunteer status", class: "mb-1 block text-xs font-medium text-gray-600" %>
        <%= f.select "segment_filters[volunteer_status]",
            [["All", ""], ["Active", "active"], ["Inactive", "inactive"], ["Pending", "pending"]],
            { selected: broadcast.segment_filters["volunteer_status"] },
            class: "#{field_class} h-9",
            data: { action: "change->segment-builder#preview" } %>
      </div>
    </div>
    <p class="mt-3 flex items-center gap-1.5 text-xs text-gray-500">
      <%= icon "users", size: 13 %>
      Estimated recipients: <strong class="text-gray-900" data-segment-builder-target="count">–</strong>
    </p>
  </div>

  <div class="mb-4">
    <%= f.label :subject, "Subject", class: "mb-1.5 block text-[13px] font-medium text-gray-900" %>
    <%= f.text_field :subject, placeholder: "What is this about?", class: "#{field_class} h-10" %>
  </div>

  <div>
    <%= f.label :body, "Message", class: "mb-1.5 block text-[13px] font-medium text-gray-900" %>
    <%= f.text_area :body, rows: 6, placeholder: "What do you need them to know?",
        class: "#{field_class} min-h-35 resize-y p-3.5 leading-normal" %>
  </div>

  <div class="mt-4.5 flex items-center gap-2.5">
    <span class="flex-1"></span>
    <%= link_to "Cancel", broadcast_messages_path, class: button_classes(:secondary) unless local_assigns[:inline] %>
    <%= f.button class: button_classes(:primary) do %>
      <%= button_content(broadcast.persisted? ? "Update broadcast" : "Save broadcast", "check", nil) %>
    <% end %>
  </div>
  <p class="mt-2 text-right text-[11px] text-gray-500">You can review and send it on the next page.</p>
<% end %>
