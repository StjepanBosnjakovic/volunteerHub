<% content_for :title, "Broadcasts — VolunteerOS" %>
<% content_for :page_title, "Broadcasts" %>
<% content_for :page_subtitle, "Send updates to many volunteers at once." %>

<% status_tones = { "draft" => :neutral, "sending" => :warn, "sent" => :ok, "failed" => :danger } %>
<% channel_labels = { "in_app" => "In-app", "email" => "Email", "sms" => "SMS", "whatsapp" => "WhatsApp" } %>

<div class="grid gap-6 lg:grid-cols-2">
  <% if policy(BroadcastMessage).create? %>
    <div><%= render "form", broadcast: @broadcast, programs: @programs, inline: true %></div>
  <% end %>

  <section>
    <div class="mb-3.5 flex items-center justify-between">
      <h2 class="text-xl font-semibold text-gray-900">Recent broadcasts</h2>
    </div>
    <% if @broadcasts.empty? %>
      <div class="<%= card_classes %> p-10 text-center text-sm text-gray-500">No broadcasts sent yet.</div>
    <% else %>
      <div class="grid gap-3">
        <% @broadcasts.each do |broadcast| %>
          <div class="<%= card_classes %> p-5">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <%= pill "#{broadcast.segment_filters.compact_blank.any? ? broadcast.segment_filters.compact_blank.map { |k, v| "#{k.humanize}: #{v}" }.join(', ') : 'Everyone'} · #{broadcast.recipient_count}", tone: :accent, dot: false %>
                </div>
                <h3 class="mt-2.5 text-[15px] font-semibold text-gray-900">
                  <%= link_to broadcast.subject, broadcast_message_path(broadcast), class: "hover:text-indigo-600" %>
                </h3>
                <div class="mt-1 text-sm leading-normal text-gray-700"><%= broadcast.body.truncate(140) %></div>
              </div>
              <div class="flex-none font-mono text-[11px] text-gray-500">
                <%= broadcast.sent_at ? broadcast.sent_at.strftime("%b %-d · %-l:%M %p") : "Not sent" %>
              </div>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-3 border-t border-gray-100 pt-3">
              <%= pill broadcast.status.humanize, tone: status_tones[broadcast.status] %>
              <%= pill channel_labels[broadcast.channel], tone: :info, dot: false, css: "text-[11px]" %>
              <span class="flex-1"></span>
              <%= button_link "View", broadcast_message_path(broadcast), variant: :ghost, size: :sm %>
              <% if policy(broadcast).send_broadcast? && broadcast.draft? %>
                <%= button_to send_broadcast_broadcast_message_path(broadcast), method: :patch,
                    data: { turbo_confirm: "Send this broadcast?" }, class: button_classes(:primary, :sm) do %>
                  <%= button_content "Send", "send", nil, :sm %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
