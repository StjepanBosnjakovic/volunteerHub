<% content_for :title, "Messages — VolunteerOS" %>
<% content_for :page_title, "Messages" %>
<% content_for :page_subtitle, "Direct conversations with volunteers and coordinators." %>
<% content_for :full_bleed, true %>

<div class="grid h-[calc(100vh-87px)] md:grid-cols-[300px_1fr]">
  <%= render "conversations/inbox", conversations: @conversations %>

  <section class="hidden flex-col items-center justify-center bg-gray-50 p-8 text-center md:flex">
    <span class="mb-4 inline-flex h-16 w-16 items-center justify-center rounded-2xl border border-gray-200 bg-white text-gray-400">
      <%= icon "message-circle", size: 28 %>
    </span>
    <div class="text-[22px] font-semibold text-gray-900">Select a conversation</div>
    <div class="mt-2 max-w-sm text-sm text-gray-500">Pick a thread from your inbox, or start a new one.</div>
    <%= button_link "New conversation", new_conversation_path, icon: "square-pen", css: "mt-5" %>
  </section>
</div>
