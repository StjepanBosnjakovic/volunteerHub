<% unread = conversation.unread_count_for(current_user) %>
<% active = local_assigns[:active] %>
<% title = conversation.display_title(current_user) %>
<%= link_to conversation_path(conversation),
    class: "grid grid-cols-[36px_1fr_auto] items-center gap-3 border-l-3 px-4 py-3 transition-colors #{active ? 'border-l-indigo-600 bg-indigo-50' : 'border-l-transparent hover:bg-gray-100/70'}" do %>
  <%= avatar title %>
  <div class="min-w-0">
    <div class="flex items-center justify-between gap-2">
      <span class="flex min-w-0 items-center gap-1.5">
        <span class="truncate text-[13px] font-semibold text-gray-900"><%= title %></span>
        <% if conversation.group_chat? %>
          <%= pill "Group", dot: false, css: "px-1.5 text-[10px]" %>
        <% end %>
      </span>
      <% if conversation.messages.any? %>
        <span class="shrink-0 text-[11px] text-gray-500"><%= time_ago_in_words(conversation.updated_at) %></span>
      <% end %>
    </div>
    <% last_msg = conversation.messages.ordered.last %>
    <% if last_msg %>
      <div class="mt-0.5 truncate text-xs text-gray-500">
        <%= last_msg.sender == current_user ? "You" : last_msg.sender.display_name %>:
        <%= last_msg.body.to_plain_text.truncate(60) %>
      </div>
    <% end %>
  </div>
  <% if unread > 0 %>
    <span class="rounded-full bg-orange-500 px-1.5 py-px text-[11px] font-bold text-white"><%= unread %></span>
  <% else %>
    <span></span>
  <% end %>
<% end %>
