<% source = { "auto" => ["Check-in", :brand], "self_logged" => ["Self-logged", :warn], "bulk" => ["CSV import", :info] }[hour_log.source.to_s] %>
<% status_tone = hour_log.approved? ? :ok : hour_log.rejected? ? :danger : :warn %>
<div id="hour_log_<%= hour_log.id %>"
     class="grid grid-cols-[1fr_auto] items-center gap-3 px-4.5 py-3.5 md:grid-cols-[1fr_140px_110px_80px_190px] <%= hour_log.disputed? ? 'bg-yellow-50' : '' %>">
  <div class="flex min-w-0 items-center gap-3">
    <%= avatar hour_log.volunteer_profile.full_name %>
    <div class="min-w-0">
      <div class="text-sm font-semibold text-gray-900">
        <% if current_user.admin? %>
          <%= link_to hour_log.volunteer_profile.full_name, volunteer_profile_path(hour_log.volunteer_profile),
              class: "hover:text-indigo-600", data: { turbo_frame: "_top" } %>
        <% else %>
          <%= hour_log.volunteer_profile.full_name %>
        <% end %>
      </div>
      <div class="truncate text-xs text-gray-500">
        <%= [hour_log.shift&.title || hour_log.program.name, hour_log.description.presence].compact.join(" · ") %>
      </div>
    </div>
  </div>
  <div class="hidden md:block"><%= pill source[0], tone: source[1], dot: false %></div>
  <div class="hidden text-[13px] text-gray-600 md:block"><%= hour_log.date.strftime("%b %-d, %Y") %></div>
  <div class="text-lg font-bold text-gray-900"><%= number_with_precision(hour_log.hours, precision: 2, strip_insignificant_zeros: true) %>h</div>
  <div class="col-span-2 flex flex-wrap items-center justify-end gap-1.5 md:col-span-1">
    <% if policy(hour_log).approve? && hour_log.pending? %>
      <%= button_to "Reject", reject_hour_log_path(hour_log), method: :patch,
          params: { rejection_reason: "Not approved." }, class: button_classes(:ghost, :sm) %>
      <%= button_to approve_hour_log_path(hour_log), method: :patch, class: button_classes(:primary, :sm) do %>
        <%= button_content "Approve", "check", nil, :sm %>
      <% end %>
    <% else %>
      <%= pill(hour_log.disputed? ? "Disputed" : hour_log.status.capitalize, tone: hour_log.disputed? ? :warn : status_tone) %>
    <% end %>
    <% if policy(hour_log).dispute? && hour_log.auto? && !hour_log.disputed? %>
      <%= button_to "Dispute", dispute_hour_log_path(hour_log), method: :patch,
          params: { dispute_note: "Hours are incorrect." }, class: button_classes(:ghost, :sm) %>
    <% end %>
  </div>
</div>
