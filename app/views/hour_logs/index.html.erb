<% content_for :title, "Hours — VolunteerOS" %>
<% content_for :page_title, "Hours" %>
<% content_for :page_subtitle, current_user.admin? ? "Logged hours and approval queue." : "Your volunteering hour log." %>

<% fmt = ->(h) { number_with_precision(h, precision: 1, strip_insignificant_zeros: true, delimiter: ",") } %>
<% month_delta = if @stats[:last_month_hours].positive?
     change = ((@stats[:month_hours] - @stats[:last_month_hours]) / @stats[:last_month_hours] * 100).round
     "#{change.positive? ? '+' : ''}#{change}% vs #{1.month.ago.strftime('%b')}"
   else
     "Approved hours in #{Date.current.strftime('%B')}"
   end %>

<div class="mb-5.5 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
  <%= render "shared/kpi_card", label: "Hours this month", value: fmt.(@stats[:month_hours]), icon: "clock",
      delta: month_delta, delta_tone: (@stats[:month_hours] >= @stats[:last_month_hours] ? :ok : nil) %>
  <%= render "shared/kpi_card", label: "Pending approval", value: @stats[:pending], icon: "hourglass",
      delta: "#{@stats[:pending]} from #{pluralize(@stats[:pending_volunteers], 'volunteer')}" %>
  <%= render "shared/kpi_card", label: "Approved all time", value: fmt.(@stats[:total_hours]), icon: "award", delta: "hours" %>
  <%= render "shared/kpi_card", label: "Active volunteers", value: @stats[:active_volunteers], icon: "users", delta: "with approved hours this month" %>
</div>

<% tab_actions = capture do %>
  <% if current_user.role_volunteer? %>
    <%= button_link "Log hours", new_hour_log_path, size: :sm, icon: "plus" %>
  <% end %>
  <% if policy(HourLog).bulk_import? %>
    <%= button_link "Bulk import", bulk_import_hour_logs_path, variant: :secondary, size: :sm, icon: "upload" %>
  <% end %>
  <%= button_link "Export CSV", hour_logs_path(format: :csv, tab: @tab, program_id: params[:program_id], from: params[:from], to: params[:to]),
      variant: :secondary, size: :sm, icon: "download" %>
<% end %>

<% tabs = current_user.admin? ? [["pending", "Pending approval"], ["approved", "Approved"], ["rejected", "Rejected"], ["disputed", "Disputed"]] : [["mine", "My hours"], ["approved", "Approved"], ["pending", "Pending"]] %>
<%= render "shared/tabs", actions: tab_actions, tabs: tabs.map { |key, label|
  { label: label, count: @tab_counts[key], active: @tab == key,
    path: hour_logs_path(tab: key, program_id: params[:program_id], from: params[:from], to: params[:to]) }
} %>

<%= form_with url: hour_logs_path, method: :get, class: "mb-4 flex flex-wrap items-end gap-3", data: { turbo_frame: "_top" } do |f| %>
  <%= f.hidden_field :tab, value: @tab %>
  <div>
    <%= f.label :program_id, "Program", class: "mb-1 block text-xs font-medium text-gray-600" %>
    <%= f.select :program_id, @programs.map { |p| [p.name, p.id] }, { include_blank: "All programs", selected: params[:program_id] },
        class: "h-8 rounded-lg border border-gray-300 px-2 py-0 text-[13px]" %>
  </div>
  <div>
    <%= f.label :from, "From", class: "mb-1 block text-xs font-medium text-gray-600" %>
    <%= f.date_field :from, value: params[:from], class: "h-8 rounded-lg border border-gray-300 px-2 text-[13px]" %>
  </div>
  <div>
    <%= f.label :to, "To", class: "mb-1 block text-xs font-medium text-gray-600" %>
    <%= f.date_field :to, value: params[:to], class: "h-8 rounded-lg border border-gray-300 px-2 text-[13px]" %>
  </div>
  <%= f.button class: button_classes(:secondary, :sm) do %>
    <%= button_content "Filter", "filter", nil, :sm %>
  <% end %>
  <%= link_to "Clear", hour_logs_path, class: "self-center text-[13px] text-gray-500 hover:underline" %>
<% end %>

<turbo-frame id="hour_logs_list">
  <div class="<%= card_classes %> overflow-hidden">
    <div class="hidden grid-cols-[1fr_140px_110px_80px_190px] gap-3 border-b border-gray-100 px-4.5 py-2.5 text-[11px] font-semibold uppercase tracking-wider text-gray-500 md:grid">
      <div>Volunteer &amp; activity</div><div>Source</div><div>Date</div><div>Hours</div><div></div>
    </div>
    <% if @hour_logs.empty? %>
      <div class="p-12 text-center text-gray-500">
        <%= icon "circle-check", size: 36, css: "mx-auto text-green-500" %>
        <div class="mt-2 text-lg font-semibold text-gray-900">Nothing here.</div>
        <div class="mt-1 text-[13px]">No hour logs match this view.</div>
      </div>
    <% else %>
      <div class="divide-y divide-gray-100">
        <% @hour_logs.each do |hour_log| %>
          <%= render "hour_logs/row", hour_log: hour_log %>
        <% end %>
      </div>
    <% end %>
  </div>
  <%= render "shared/pagination", pagy: @pagy %>
</turbo-frame>
