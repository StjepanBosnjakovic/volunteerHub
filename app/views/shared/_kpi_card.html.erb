<%# KPI tile. locals: label, value, icon, delta (optional), delta_tone (:ok or nil), value_class (optional) %>
<div class="<%= card_classes %> p-5">
  <div class="flex items-center justify-between">
    <%= eyebrow label %>
    <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-indigo-50 text-indigo-700">
      <%= icon local_assigns[:icon], size: 14 %>
    </span>
  </div>
  <div class="mt-2.5 text-3xl font-bold leading-tight tracking-tight <%= local_assigns[:value_class] || 'text-gray-900' %>"><%= value %></div>
  <% if local_assigns[:delta] %>
    <div class="mt-1 text-xs <%= local_assigns[:delta_tone] == :ok ? 'text-green-600' : 'text-gray-500' %>"><%= delta %></div>
  <% end %>
</div>
