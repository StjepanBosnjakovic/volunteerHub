<%# Underlined tab row. tabs: array of { label:, path:, active:, count: (optional) } %>
<div class="mb-5 flex flex-wrap items-center gap-x-6 border-b border-gray-200">
  <% tabs.each do |tab| %>
    <%= link_to tab[:path], class: "-mb-px inline-flex items-center gap-2 border-b-2 px-0.5 py-3 text-sm #{tab[:active] ? 'border-indigo-600 font-semibold text-gray-900' : 'border-transparent font-medium text-gray-500 hover:text-gray-700'}",
        data: { turbo_frame: "_top" } do %>
      <%= tab[:label] %>
      <% unless tab[:count].nil? %>
        <span class="rounded-full px-1.5 py-px text-[11px] font-bold <%= tab[:active] ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-500' %>"><%= tab[:count] %></span>
      <% end %>
    <% end %>
  <% end %>
  <% if local_assigns[:actions] %>
    <div class="flex-1"></div>
    <div class="flex items-center gap-2 py-2"><%= actions %></div>
  <% end %>
</div>
