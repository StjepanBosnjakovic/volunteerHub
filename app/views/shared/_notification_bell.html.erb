<div class="relative" data-controller="notification-bell">
  <%= turbo_stream_from "notifications_#{current_user.id}" %>

  <button type="button"
          data-action="click->notification-bell#toggle"
          title="Notifications"
          class="relative inline-flex h-9.5 w-9.5 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-700 hover:bg-gray-50 focus:outline-none cursor-pointer">
    <%= icon "bell" %>

    <span id="notification_bell_count"
          class="<%= current_user.notifications.unread.count > 0 ? 'inline-flex' : 'hidden' %>
                 absolute -top-1.5 -right-1.5 items-center justify-center
                 h-4 min-w-4 px-1 text-[10px] font-bold text-white bg-orange-500 rounded-full ring-2 ring-white">
      <%= current_user.notifications.unread.count %>
    </span>
  </button>

  <div data-notification-bell-target="dropdown"
       class="hidden absolute right-0 top-full mt-2 w-80 bg-white rounded-lg shadow-lg border border-gray-200 z-50">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
      <span class="text-sm font-semibold text-gray-900">Notifications</span>
      <%= link_to "View all", notifications_path, class: "text-xs text-indigo-600 hover:underline" %>
    </div>
    <div class="max-h-96 overflow-y-auto divide-y divide-gray-50">
      <% current_user.notifications.unread.recent.each do |notification| %>
        <div class="px-4 py-3 hover:bg-gray-50">
          <p class="text-sm text-gray-800 font-medium"><%= notification_message(notification) %></p>
          <p class="text-xs text-gray-400 mt-0.5"><%= time_ago_in_words(notification.created_at) %> ago</p>
        </div>
      <% end %>
      <% if current_user.notifications.unread.none? %>
        <div class="px-4 py-6 text-center text-sm text-gray-400">You're all caught up!</div>
      <% end %>
    </div>
  </div>
</div>
