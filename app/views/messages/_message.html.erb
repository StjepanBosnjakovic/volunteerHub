<% own = message.sender_id == current_user.id %>
<div id="message_<%= message.id %>"
     class="flex <%= own ? 'justify-end' : 'justify-start' %> gap-2">
  <% unless own %>
    <%= avatar message.sender.display_name, size: :md, css: "mt-5" %>
  <% end %>

  <div class="max-w-[70%]">
    <% unless own %>
      <p class="mb-1 ml-1 text-xs text-gray-500"><%= message.sender.display_name %></p>
    <% end %>
    <div class="rounded-2xl px-3.5 py-2.5 text-sm leading-relaxed
         <%= own ? 'rounded-br-sm bg-indigo-600 text-white' : 'rounded-bl-sm border border-gray-200 bg-white text-gray-900' %>">
      <%= message.body %>
      <p class="mt-1 font-mono text-[10px] <%= own ? 'text-white/70' : 'text-gray-400' %>">
        <%= message.created_at.strftime("%H:%M") %>
        <% if own && message.message_reads.any? %>
          · Read
        <% end %>
      </p>
    </div>
  </div>
</div>
