<%= form_with url: conversation_messages_path(conversation),
    method: :post,
    data: { controller: "message-composer", action: "submit->message-composer#clearOnSuccess" } do |f| %>
  <div class="flex items-end gap-2 rounded-2xl border border-gray-300 bg-white py-2 pr-2 pl-3.5 focus-within:border-indigo-500 focus-within:ring-4 focus-within:ring-indigo-500/15">
    <%= f.text_area :message, name: "message[body]",
        rows: 1,
        placeholder: "Message #{conversation.display_title(current_user)}…",
        class: "max-h-30 flex-1 resize-none border-0 bg-transparent py-2 text-sm leading-normal text-gray-900 focus:outline-none focus:ring-0",
        data: { "message-composer-target" => "input", action: "keydown->message-composer#submitOnEnter" } %>
    <button type="submit" title="Send" aria-label="Send"
            class="<%= button_classes(:primary, :icon) %>">
      <%= icon "send", size: 16 %>
    </button>
  </div>
  <div class="mt-1.5 text-[11px] text-gray-500">Ctrl+Enter or ⌘+Enter to send</div>
<% end %>
