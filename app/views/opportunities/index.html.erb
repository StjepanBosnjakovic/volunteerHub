<% content_for :title, "Volunteer Opportunities — VolunteerOS" %>
<% content_for :page_title, "Opportunities" %>
<% content_for :page_subtitle, "Public listings and application pipeline." %>

<% unless user_signed_in? %>
  <h1 class="mb-6 text-2xl font-bold text-gray-900">Volunteer Opportunities</h1>
<% end %>

<% field_class = "h-8 rounded-lg border border-gray-300 bg-white px-2 text-[13px]" %>
<% tab_actions = capture do %>
  <% if user_signed_in? && policy(Opportunity).create? %>
    <%= button_link "New opportunity", new_opportunity_path, size: :sm, icon: "plus" %>
  <% end %>
<% end %>

<% filter_params = params.permit(:commitment_level, :from, :to).to_h.symbolize_keys %>
<% tabs = [["all", "All listings", nil], ["published", "Published", "published"], ["draft", "Drafts", "draft"], ["closed", "Closed", "closed"]] %>
<% tabs = tabs.first(1) unless user_signed_in? && policy(Opportunity).create? %>
<%= render "shared/tabs", actions: tab_actions, tabs: tabs.map { |key, label, status|
  { label: label, count: @status_counts.fetch(key, 0), active: @status == status,
    path: opportunities_path(**filter_params, status: status) }
} %>

<%= form_with url: opportunities_path, method: :get, class: "mb-4 flex flex-wrap items-end gap-3", data: { turbo_frame: "opportunities_list", turbo_action: "advance" } do |f| %>
  <%= f.hidden_field :status, value: @status %>
  <div>
    <label class="mb-1 block text-xs font-medium text-gray-600">Commitment</label>
    <%= f.select :commitment_level,
        options_for_select(Opportunity::COMMITMENT_LEVELS.map { |l| [l.humanize, l] }, params[:commitment_level]),
        { include_blank: "Any commitment" }, class: "#{field_class} py-0" %>
  </div>
  <div>
    <label class="mb-1 block text-xs font-medium text-gray-600">From</label>
    <%= f.date_field :from, value: params[:from], class: field_class %>
  </div>
  <div>
    <label class="mb-1 block text-xs font-medium text-gray-600">To</label>
    <%= f.date_field :to, value: params[:to], class: field_class %>
  </div>
  <%= f.button class: button_classes(:secondary, :sm) do %>
    <%= button_content "Filter", "filter", nil, :sm %>
  <% end %>
  <%= link_to "Clear", opportunities_path(status: @status), class: "self-center text-[13px] text-gray-500 hover:underline" %>
<% end %>

<%= turbo_frame_tag "opportunities_list" do %>
  <% if @opportunities.any? %>
    <div class="grid gap-3">
      <% @opportunities.each do |opportunity| %>
        <%= render "opportunities/card", opportunity: opportunity, applications: @application_counts.fetch(opportunity.id, 0) %>
      <% end %>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <div class="<%= card_classes %> py-16 text-center">
      <%= icon "sparkles", size: 32, css: "mx-auto mb-3 text-gray-300" %>
      <p class="text-gray-500">No opportunities found.</p>
      <% if user_signed_in? && policy(Opportunity).create? %>
        <p class="mt-2"><%= link_to "Create the first opportunity", new_opportunity_path, class: "text-indigo-600 hover:text-indigo-800", data: { turbo_frame: "_top" } %></p>
      <% end %>
    </div>
  <% end %>
<% end %>
