<% if notice.present? %>
  <div class="max-w-7xl px-4 pt-4 sm:px-7">
    <div class="flex items-center gap-2 rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-800" data-controller="flash">
      <%= icon "circle-check", size: 16 %>
      <%= notice %>
    </div>
  </div>
<% end %>

<% if alert.present? %>
  <div class="max-w-7xl px-4 pt-4 sm:px-7">
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <%= alert %>
    </div>
  </div>
<% end %>
