<% items.each do |item| %>
  <% active = nav_item_active?(item) %>
  <%= link_to item.path, class: "flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm transition-colors #{active ? 'bg-indigo-500/20 font-semibold text-white' : 'font-medium text-white/75 hover:bg-white/5 hover:text-white'}",
      aria: { current: (active ? "page" : nil) } do %>
    <%= icon item.icon %>
    <span class="flex-1"><%= item.label %></span>
    <% if item.count %>
      <span class="rounded-full px-1.5 py-px text-[11px] font-bold <%= active ? 'bg-indigo-500 text-white' : 'bg-white/10 text-white/70' %>"><%= item.count %></span>
    <% end %>
  <% end %>
<% end %>
