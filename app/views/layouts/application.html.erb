<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "VolunteerOS" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="VolunteerOS">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% if user_signed_in? && current_user.organisation&.setup_complete? %>
    <body class="bg-gray-50 text-gray-900">
      <div class="flex h-screen">
        <%= render "layouts/sidebar" %>

        <div class="flex min-w-0 flex-1 flex-col">
          <div class="flex-1 overflow-y-auto overflow-x-hidden">
            <%= render "layouts/topbar" %>
            <%= render "layouts/flash" %>

            <% if content_for?(:full_bleed) %>
              <%= yield %>
            <% else %>
              <main class="max-w-7xl px-4 py-7 sm:px-7">
                <%= yield %>
              </main>
            <% end %>
          </div>
        </div>
      </div>
    </body>
  <% else %>
    <body class="bg-gray-50 min-h-screen">
      <%= render "layouts/flash" %>

      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <%= yield %>
      </main>
    </body>
  <% end %>
</html>
