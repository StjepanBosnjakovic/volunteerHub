<aside class="hidden md:flex w-62 flex-none flex-col bg-gray-900 px-3.5 pt-5 pb-4 text-white">
  <%= link_to dashboard_path, class: "flex items-center gap-2.5 px-1.5 pb-5" do %>
    <%= image_tag "/icon.png", alt: "", class: "h-8 w-8 rounded-lg" %>
    <div class="min-w-0">
      <div class="text-[17px] font-bold tracking-tight">VolunteerOS</div>
      <div class="-mt-0.5 truncate text-[11px] text-white/55"><%= current_user.organisation.name %></div>
    </div>
  <% end %>

  <nav class="flex flex-col gap-0.5">
    <%= render "layouts/nav_items", items: primary_nav_items %>
    <% if secondary_nav_items.any? %>
      <div class="mx-1.5 my-3.5 h-px bg-white/10"></div>
      <%= render "layouts/nav_items", items: secondary_nav_items %>
    <% end %>
  </nav>

  <div class="flex-1"></div>

  <div class="mt-3 flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 p-3">
    <%= avatar current_user.display_name, size: :md %>
    <div class="min-w-0 flex-1">
      <div class="truncate text-[13px] font-semibold"><%= current_user.display_name %></div>
      <div class="text-[11px] text-white/55"><%= current_user.role.humanize %></div>
    </div>
    <%= button_to destroy_user_session_path, method: :delete, title: "Sign out",
        class: "rounded-md p-1.5 text-white/60 hover:bg-white/10 hover:text-white cursor-pointer" do %>
      <%= icon "log-out", size: 16 %>
    <% end %>
  </div>
</aside>
