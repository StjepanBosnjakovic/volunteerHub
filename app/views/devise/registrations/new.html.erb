<% field_class = "h-10 w-full rounded-lg border border-gray-300 bg-white px-3 text-sm text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/15" %>
<% label_class = "mb-1.5 block text-[13px] font-medium text-gray-900" %>
<% content_for :auth_footer do %>
  Already have an account?
  <%= link_to "Sign in", new_session_path(resource_name), class: "font-semibold text-indigo-600 hover:text-indigo-700" %>
<% end %>

<%= render layout: "devise/shared/auth_frame", locals: { title: "Create your account", subtitle: "Set up your organisation and get started." } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "flex flex-col gap-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= label_tag "user[organisation_name]", "Organisation name", class: label_class %>
      <%= text_field_tag "user[organisation_name]", nil, autocomplete: "organization", placeholder: "e.g. City Food Bank", class: field_class %>
    </div>

    <div>
      <%= f.label :email, class: label_class %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: field_class %>
    </div>

    <div>
      <%= f.label :password, class: label_class %>
      <%= f.password_field :password, autocomplete: "new-password", class: field_class %>
      <% if @minimum_password_length %>
        <p class="mt-1 text-xs text-gray-500"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: label_class %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: field_class %>
    </div>

    <%= button_tag type: "submit", class: "#{button_classes(:primary)} mt-1 w-full justify-center" do %>
      <%= button_content("Create account", nil, "arrow-right") %>
    <% end %>
  <% end %>
<% end %>
