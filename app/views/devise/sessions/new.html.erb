<% field_class = "h-10 w-full rounded-lg border border-gray-300 bg-white px-3 text-sm text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/15" %>
<% label_class = "mb-1.5 block text-[13px] font-medium text-gray-900" %>
<% content_for :auth_footer do %>
  Don't have an account?
  <%= link_to "Create one", new_registration_path(resource_name), class: "font-semibold text-indigo-600 hover:text-indigo-700" %>
<% end %>

<%= render layout: "devise/shared/auth_frame", locals: { title: "Sign in to your account", subtitle: "Welcome back. Enter your details to continue." } do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: label_class %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: field_class %>
    </div>

    <div>
      <div class="mb-1.5 flex items-baseline justify-between">
        <%= f.label :password, class: "block text-[13px] font-medium text-gray-900" %>
        <% if devise_mapping.recoverable? && controller_name != "passwords" %>
          <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700" %>
        <% end %>
      </div>
      <%= f.password_field :password, autocomplete: "current-password", class: field_class %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-[13px] text-gray-700">
        <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
        Remember me
      </label>
    <% end %>

    <%= button_tag type: "submit", class: "#{button_classes(:primary)} mt-1 w-full justify-center" do %>
      <%= button_content("Sign in", nil, "arrow-right") %>
    <% end %>
  <% end %>
<% end %>

