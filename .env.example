# Rails master key — copy the value from config/master.key
RAILS_MASTER_KEY=

# Postgres password for the postgres user — used in the DATABASE_URL values in docker-compose.yml
# URL-encode any special characters (for example @, :, /)
POSTGRES_PASSWORD=

# Puma tuning (optional)
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
